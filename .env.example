# Company Brain startup configuration example.
# Copy to `.env` (root, git-ignored). Names/defaults only; external secret
# values stay EMPTY until after Phase 2 implementation (workspace_setup.md).

# --- Application ------------------------------------------------------------
APP_NAME=company-brain
TENANT_ID=demo
PRINCIPAL_ID=demo-operator
SOURCE_MODE=FIXTURE

# --- FalkorDB (local Docker; credentials are locally generated, no account) --
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
# Leave username/password empty for the default local container configuration.
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
FALKORDB_GRAPH_NAME=company_brain_demo
FALKORDB_QUERY_TIMEOUT_MS=1000

# --- Clarification / event batching policy -----------------------------------
CLARIFICATION_TTL_SECONDS=120
EVENT_BATCH_WINDOW_SECONDS=30
EVENT_BATCH_MIN_READ_INTERVAL_SECONDS=15
EVENT_BATCH_MAX_EVENTS=100
EVENT_BATCH_MAX_PENDING_EVENTS=1000

# --- External provider secrets (server-only; empty until after Phase 2) ------
PLANE_API_KEY=
PLANE_BASE_URL=https://api.plane.so
GOOGLE_DOCS_CLIENT_ID=
GOOGLE_DOCS_CLIENT_SECRET=
GITHUB_TOKEN=
ANSWER_LLM_API_KEY=
DECISION_MODEL_API_KEY=
